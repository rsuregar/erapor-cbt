{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CBT Al Akhyar",
  "version": "0.2.0",
  "identifier": "id.sch.alakhyar.cbt",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5180",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "CBT Al Akhyar - Exam Browser",
        "width": 1280,
        "height": 800,
        "resizable": false,
        "fullscreen": true,
        "alwaysOnTop": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
